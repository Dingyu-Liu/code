# ============================================
#  .env.example —— 模板文件（这个可以提交到 git）
#  作用：告诉别人「这个项目需要配哪些变量」
#  用法：复制一份，改名为 .env，再把值换成你自己的
# ============================================

# DeepSeek 的 API Key
# 去 https://platform.deepseek.com 申请，形如 sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_API_KEY=your_key_here

# 可以继续往下加，一行一个，格式都是 变量名=值
# 注意：等号两边不要加空格，值不要加引号（除非值里有空格）
