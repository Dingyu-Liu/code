# ============================================
#  .gitignore —— 告诉 Git「这些文件不要管」
#  每一行都是一个规则，写在这里的东西永远不会被提交
# ============================================

# ---------- Python ----------
# 虚拟环境：体积巨大（你这个有 160MB），且可以用 requirements.txt 重建
.venv/
venv/
env/
ENV/

# Python 运行时自动生成的缓存
__pycache__/
*.py[cod]
*$py.class

# 打包产物
build/
dist/
*.egg-info/

# ---------- C / C++ 编译产物 ----------
# 这些是「编译出来的东西」，不是源代码，不应该进版本库
*.o
*.obj
*.exe
*.out
*.a
*.so
*.dll
*.dylib

# ---------- 编辑器 / IDE 的个人设置 ----------
.vscode/
.idea/
*.swp

# ---------- 系统杂项 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 日志 / 临时文件 ----------
*.log
*.tmp
